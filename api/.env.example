POSTGRES_DB=complaints
POSTGRES_USER=complaints
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+psycopg://complaints:replace-with-strong-postgres-password@postgres:5432/complaints
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-32-plus-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
SLA_CHECK_INTERVAL_SECONDS=300
# Set true only when a reverse proxy rewrites X-Forwarded-For, otherwise
# clients can spoof the header and bypass the rate limiter.
TRUST_PROXY_HEADERS=false
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-strong-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
